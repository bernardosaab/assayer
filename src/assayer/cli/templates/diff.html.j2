{% extends "base.html.j2" %}
{% set c = r.comparison %}
{% block title %}{{ c.base_run }} vs {{ c.candidate_run }}{% endblock %}
{% block body %}
<h1>{{ r.base.eval_name }}: paired comparison
  <span class="badge {{ 'fail' if r.regressed else 'pass' }}">{{ "regression" if r.regressed else "within gate" }}</span></h1>
<p class="sub"><code>{{ c.base_run }}</code> (base) vs <code>{{ c.candidate_run }}</code> (candidate) · gate: fail if the paired pass rate drops by more than {{ r.max_drop | pct }}</p>

<div class="grid">
  <div class="card kpi">
    <div class="label">Base pass rate</div>
    <div class="value">{{ c.base.pass_rate | pct }}</div>
    {% set lo, hi = c.base.interval %}<div class="note">95% CI {{ lo | pct }} to {{ hi | pct }} · n={{ c.base.graded }}</div>
  </div>
  <div class="card kpi">
    <div class="label">Candidate pass rate</div>
    <div class="value">{{ c.candidate.pass_rate | pct }}</div>
    {% set lo, hi = c.candidate.interval %}<div class="note">95% CI {{ lo | pct }} to {{ hi | pct }} · n={{ c.candidate.graded }}</div>
  </div>
  <div class="card kpi">
    <div class="label">Paired change</div>
    <div class="value">{% if c.paired_delta is not none %}{{ "+" if c.paired_delta >= 0 }}{{ c.paired_delta | pct }}{% else %}n/a{% endif %}</div>
    <div class="note">{{ c.improvements }} improved · {{ c.regressions }} regressed · {{ c.pairs }} pairs</div>
  </div>
  <div class="card kpi">
    <div class="label">McNemar exact p</div>
    <div class="value">{{ "%.3f" | format(c.p_value) }}</div>
    <div class="note">{% if c.resolvable_change is not none %}changes under ±{{ c.resolvable_change | pct }} are within noise at this n{% endif %}</div>
  </div>
</div>

<h2>Flipped cases</h2>
<div class="card">
{% if c.flips %}
<table>
  <tr><th>Case # repeat</th><th>Base</th><th>Candidate</th></tr>
  {% for f in c.flips %}
  <tr><td><code>{{ f.key }}</code></td><td><span class="badge {{ f.base.value }}">{{ f.base.value }}</span></td>
      <td><span class="badge {{ f.candidate.value }}">{{ f.candidate.value }}</span></td></tr>
  {% endfor %}
</table>
{% else %}<p class="muted">No case changed outcome.</p>{% endif %}
{% if c.unpaired %}<p class="muted">{{ c.unpaired }} attempts exist in only one run and are not compared.</p>{% endif %}
</div>

<h2>What changed</h2>
<div class="grid">
  {% for label, m in [("Base", r.base), ("Candidate", r.candidate)] %}
  <div class="card">
    <strong>{{ label }}</strong>
    <dl class="meta">
      <dt>Run</dt><dd><code>{{ m.run_id }}</code>{% if m.replay_of %} (replay of <code>{{ m.replay_of }}</code>){% endif %}</dd>
      <dt>Git</dt><dd><code>{{ (m.git_sha or "unknown")[:12] }}</code></dd>
      <dt>Prompt</dt><dd><code>{{ m.prompt_version }}</code></dd>
      <dt>Judge</dt><dd><code>{{ m.judge_version or "none" }}</code></dd>
      <dt>Grader</dt><dd><code>{{ m.grader_version }}</code></dd>
      <dt>Agent model</dt><dd><code>{{ m.models.agent }}</code></dd>
    </dl>
  </div>
  {% endfor %}
</div>
{% endblock %}
